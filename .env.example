# Backend
PORT=3000
WEBHOOK_SECRET=cambia_esto_por_un_secret_seguro
# Opcional: token distinto para /metrics y /dashboard (si falta, se usa WEBHOOK_SECRET)
METRICS_TOKEN=
# Docker publica servicios solo en localhost; el proxy del host accede allí.
BIND_ADDRESS=127.0.0.1

# UI Asesores — autenticación
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_para_jwt
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Acceso automatizado a notas: 1 solo tras validación y aprobación institucional.
TOOLI_NOTAS_SSO_ENABLED=0
# Consulta de turno/recibo por código: 1 solo tras validar titularidad del estudiante.
TOOLI_ACADEMIC_LOOKUP_ENABLED=0
# Cursos de Savio: habilitar solo tras crear un servicio Moodle de lectura y
# probar sus permisos con una cuenta institucional de ensayo. No usar token admin.
TOOLI_SAVIO_ENABLED=0
SAVIO_WS_TOKEN=

# ── Datos académicos (docs/datos-academicos.md) ──────────────────────────────
# Horario de clases. Solo funciona con la sesión guardada (TOOLI_NOTAS_CAMINO=A).
TOOLI_HORARIO_ENABLED=0
# Proveedor de horario: banner (real) o simulado (SOLO pruebas; se ignora en producción).
TOOLI_HORARIO_PROVEEDOR=banner
# Camino de las notas: B = contraseña en cada consulta, no se guarda nada (por defecto).
# A = con consentimiento guarda CIFRADA la sesión de Banner (nunca la contraseña) por unas horas;
# la voz puede reutilizarla. A exige TOOLI_ACADEMICO_CLAVE; sin clave válida se usa B.
TOOLI_NOTAS_CAMINO=B
TOOLI_NOTAS_SESION_HORAS=12
# Clave de 32 bytes en hex (64 caracteres) o base64: openssl rand -hex 32
# Cifra la sesión guardada (camino A) y la cédula. OBLIGATORIA si TOOLI_ACADEMIC_LOOKUP_ENABLED=1: sin ella la cédula
# no se guarda y el recibo no se puede bajar (el preflight detiene el despliegue y el arranque lo dice). También la
# necesitan TOOLI_NOTAS_CAMINO=A y TOOLI_HORARIO_ENABLED=1 (sin ella caen a B y el horario manda al autoservicio).
TOOLI_ACADEMICO_CLAVE=
# Clave PROPIA de los índices de búsqueda por código y cédula (32+ caracteres: openssl rand -hex 32). De ella se
# deriva el secreto con HKDF; así rotar JWT_SECRET o TOOLI_ACADEMICO_CLAVE ya no deja huérfanos los índices (#38).
# Sin ella se sigue usando TOOLI_ACADEMICO_CLAVE (o JWT_SECRET) como antes. Al ponerla, lo viejo se sigue leyendo
# y se pasa a la nueva con: node --env-file=.env --import tsx tools/migrar-indices-busqueda.ts --aplicar
# No la cambies después: cambiarla obliga a migrar de nuevo (los índices se leen con ella y con la de antes).
TOOLI_BUSQUEDA_CLAVE=
# Regla de notas de la UTB. SIN CONFIRMAR: ponla según Registro Académico y marca CONFIRMADA=1.
TOOLI_NOTA_MINIMA=3.0
TOOLI_CORTES_PESOS=30,30,40
TOOLI_REGLA_NOTAS_CONFIRMADA=0
# Avisos proactivos (tareas por vencer, turno de mañana). Apagado por defecto.
TOOLI_AVISOS_ACADEMICOS_ENABLED=0

# UI Asesores — URLs públicas mostradas en el dashboard.
# En desarrollo deja localhost; en producción usa el dominio real (ej: https://chatwoot.utb.edu.co)
PUBLIC_CHATWOOT_URL=http://localhost:3001
PUBLIC_GRAFANA_URL=http://localhost:3002
PUBLIC_PANEL_URL=https://tooli-utb.duckdns.org

# Evolution API
EVOLUTION_API_BASE_URL=http://evolution-api:8080
EVOLUTION_API_INSTANCE=tooli
EVOLUTION_API_KEY=cambia_esto_por_tu_api_key
EVOLUTION_DB_PASSWORD=cambia_esto_por_un_secreto_aleatorio_sin_caracteres_de_URL

# Redis (sesiones — TTL en segundos)
REDIS_URL=redis://redis:6379
SESSION_TTL_SECONDS=3600
# Personas que el bot atiende a la vez (cada una en orden). 1 = una sola fila para todos.
INBOUND_CONCURRENCIA=6

# Chatwoot DB (debe coincidir con POSTGRES_PASSWORD en .env.chatwoot)
CHATWOOT_DB_PASSWORD=cambia_esto

# Chatwoot — credenciales que se llenan DESPUÉS del setup inicial
CHATWOOT_URL=http://chatwoot-app:3000
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_HMAC_TOKEN=
# v3.16 no firma webhooks salientes. Configura en Chatwoot la URL interna
# http://backend:3000/chatwoot-webhook?token=<este valor aleatorio de 32+ caracteres>
CHATWOOT_WEBHOOK_TOKEN=
CHATWOOT_TEAM_TI_ID=
CHATWOOT_TEAM_ADMISIONES_ID=

# Chatwoot Platform Token (opcional, para SSO de asesores).
# Se crea en: Chatwoot Super Admin → Platform Apps → Create new app
# Si está configurado, los asesores creados con email entrarán a Chatwoot sin re-login
CHATWOOT_PLATFORM_TOKEN=

# Google Sheets — pega el JSON del service account en una sola línea
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# HubSpot (CRM de la UTB) — crea o actualiza el contacto (por correo) de quien
# autoriza el tratamiento de datos: evento de posgrados y flujo de recomendación.
# Token de una Private App con scope crm.objects.contacts.write.
HUBSPOT_ACTIVO=false
HUBSPOT_TOKEN=
# Valor de la fuente según de dónde viene el lead. Si la propiedad de fuente es
# un desplegable en HubSpot, estos valores tienen que existir como opciones.
HUBSPOT_FUENTE_VALOR=Bot WhatsApp - Evento Posgrados
HUBSPOT_FUENTE_RECOMENDACION=Bot WhatsApp - Recomendación por pregrado
HUBSPOT_FUENTE_CAMPANA=Bot WhatsApp - Campaña por pregrado
# Nombre interno de las propiedades personalizadas; vacío = no se envía.
HUBSPOT_PROP_POSGRADO=
HUBSPOT_PROP_FUENTE=
HUBSPOT_PROP_CONSENTIMIENTO=
HUBSPOT_PROP_FINANCIACION=
# Flujo de recomendación: pregrado que estudió y relación con la UTB
# (egresado, estudiante u otra universidad). Mejor como propiedades de texto.
HUBSPOT_PROP_PREGRADO=
HUBSPOT_PROP_RELACION=

# Grafana (acceso al dashboard en http://localhost:3002)
GRAFANA_USER=admin
GRAFANA_PASSWORD=cambia_esto

# Firma de entregas Meta Cloud API (App Settings > Basic > App Secret).
META_APP_SECRET=

# Número de WhatsApp del bot para los QR de asistencia (solo dígitos, con
# indicativo: 573001234567). Opcional: con Meta Cloud se consulta solo.
WHATSAPP_PUBLIC_NUMBER=

# Alertmanager — destinos de alertas (opcional; si están vacíos, no se envían)
# Slack: crea un Incoming Webhook en https://api.slack.com/apps y pega la URL aquí
SLACK_WEBHOOK_URL=
# Email: solo se usa para alertas critical
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=
SMTP_PASSWORD=

# Verificación de identidad por correo (OTP) — Resend (https://resend.com)
# API key de Resend. Sin dominio verificado solo puedes enviar a tu correo de
# registro (útil para pruebas). Para producción verifica un dominio tuyo y usa
# MAIL_FROM=verificacion@tudominio.com
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# Asistente de IA (gpt-4o-mini) y notas de voz
OPENAI_API_KEY=
# Las notas de voz se transcriben y siguen la conversación como texto; false las rechaza como antes.
TRANSCRIBIR_AUDIOS=true
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Inicio conversacional de posgrados: la IA responde y el bot pregunta con botones (true para activarlo).
FLUJO_CONVERSACIONAL=false
# Seguimiento: si alguien deja una pregunta del flujo sin contestar, el bot le escribe una vez 3 horas después
# (solo con autorización de datos, nunca de noche y dentro de las 24 horas de WhatsApp). false lo apaga.
SEGUIMIENTO_CONVERSACION=true
# Agenda de asesores por WhatsApp: ofrece cita fuera de horario o sin asesor libre y atiende «agendar», «mis citas»,
# cancelar y reprogramar; la voz también ofrece citas. La disponibilidad de cada asesor se edita en el panel (Agenda).
# Viene APAGADA: true la enciende (hacerlo a propósito, con la disponibilidad de los asesores ya cargada).
AGENDA_ACTIVA=false
# Recomendaciones y fichas con el flyer de cada posgrado: foto oficial y datos con la línea gráfica UTB
# (lo arma el Chromium del servidor y se sube una vez a Meta).
FOTOS_PROGRAMAS=true

# Línea de voz (Telnyx Call Control v2). Sin TELNYX_API_KEY y TELNYX_PUBLIC_KEY la línea
# queda apagada: no se manda ningún comando y solo funciona el simulador del panel.
# TELNYX_PUBLIC_KEY: «API Keys → Public Key» (base64 de 32 bytes, firma Ed25519).
# Webhook de la aplicación de voz en Telnyx: https://<dominio>/voice/telnyx/<VOICE_WEBHOOK_KEY>
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PHONE_NUMBER=
# Clave larga y aleatoria (32+ caracteres), p. ej. `openssl rand -hex 24`.
VOICE_WEBHOOK_KEY=
# Modelo que solo ENTIENDE la frase y elige una herramienta (usa OPENAI_API_KEY). Respaldo por reglas a los 5 s.
VOICE_AI_MODEL=gpt-4o-mini
