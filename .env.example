# Backend
PORT=3000
WEBHOOK_SECRET=cambia_esto_por_un_secret_seguro
# Docker publica servicios solo en localhost; el proxy del host accede allí.
BIND_ADDRESS=127.0.0.1

# UI Asesores — autenticación
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_para_jwt
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Acceso automatizado a notas: 1 solo tras validación y aprobación institucional.
TOOLI_NOTAS_SSO_ENABLED=0
# Consulta de turno/recibo por código: 1 solo tras validar titularidad del estudiante.
TOOLI_ACADEMIC_LOOKUP_ENABLED=0

# UI Asesores — URLs públicas mostradas en el dashboard.
# En desarrollo deja localhost; en producción usa el dominio real (ej: https://chatwoot.utb.edu.co)
PUBLIC_CHATWOOT_URL=http://localhost:3001
PUBLIC_GRAFANA_URL=http://localhost:3002

# Evolution API
EVOLUTION_API_BASE_URL=http://evolution-api:8080
EVOLUTION_API_INSTANCE=tooli
EVOLUTION_API_KEY=cambia_esto_por_tu_api_key
EVOLUTION_DB_PASSWORD=cambia_esto_por_un_secreto_aleatorio_sin_caracteres_de_URL

# Redis (sesiones — TTL en segundos)
REDIS_URL=redis://redis:6379
SESSION_TTL_SECONDS=3600

# Chatwoot DB (debe coincidir con POSTGRES_PASSWORD en .env.chatwoot)
CHATWOOT_DB_PASSWORD=cambia_esto

# Chatwoot — credenciales que se llenan DESPUÉS del setup inicial
CHATWOOT_URL=http://chatwoot-app:3000
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_HMAC_TOKEN=
# v3.16 no firma webhooks salientes. Configura en Chatwoot la URL interna
# http://backend:3000/chatwoot-webhook?token=<este valor aleatorio de 32+ caracteres>
CHATWOOT_WEBHOOK_TOKEN=
CHATWOOT_TEAM_TI_ID=
CHATWOOT_TEAM_ADMISIONES_ID=

# Chatwoot Platform Token (opcional, para SSO de asesores).
# Se crea en: Chatwoot Super Admin → Platform Apps → Create new app
# Si está configurado, los asesores creados con email entrarán a Chatwoot sin re-login
CHATWOOT_PLATFORM_TOKEN=

# Google Sheets — pega el JSON del service account en una sola línea
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Grafana (acceso al dashboard en http://localhost:3002)
GRAFANA_USER=admin
GRAFANA_PASSWORD=cambia_esto

# Firma de entregas Meta Cloud API (App Settings > Basic > App Secret).
META_APP_SECRET=

# Alertmanager — destinos de alertas (opcional; si están vacíos, no se envían)
# Slack: crea un Incoming Webhook en https://api.slack.com/apps y pega la URL aquí
SLACK_WEBHOOK_URL=
# Email: solo se usa para alertas critical
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=
SMTP_PASSWORD=

# Verificación de identidad por correo (OTP) — Resend (https://resend.com)
# API key de Resend. Sin dominio verificado solo puedes enviar a tu correo de
# registro (útil para pruebas). Para producción verifica un dominio tuyo y usa
# MAIL_FROM=verificacion@tudominio.com
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
