{
  "name": "tooli-chatbot",
  "version": "0.1.0",
  "description": "Plataforma conversacional de WhatsApp de la Universidad Tecnologica de Bolivar: captacion de aspirantes a posgrado y servicios al estudiante.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ISCOUTB/tooli-chatbot.git"
  },
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/public','dist/public',{recursive:true})\"",
    "start": "node dist/index.js",
    "lint": "eslint src/public/app/js",
    "test": "node tools/run-tests.cjs",
    "test:watch": "node tools/run-tests.cjs --watch"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^171.4.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.73.0",
    "playwright": "^1.50.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "tesseract.js": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.2",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.5.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5"
  }
}
